{
  "name": "understudy",
  "version": "2.0.0",
  "description": "The LLM gateway that keeps your agents running - when a model can't go on, the understudy steps in",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t understudy .",
    "docker:run": "docker run -p 42986:42986 --env-file .env understudy",
    "login": "tsx src/cli.ts login",
    "setup": "tsx src/cli.ts setup",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@earendil-works/pi-ai": "^0.79.1",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "gateway",
    "ai-agents",
    "failover",
    "openai-compatible",
    "anthropic",
    "claude",
    "rate-limit",
    "circuit-breaker",
    "streaming",
    "sse",
    "cost-tracking",
    "openclaw",
    "hermes-agent",
    "claude-code",
    "codex",
    "opencode",
    "anthropic-messages",
    "openai-responses",
    "failover-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariangibson/understudy.git"
  },
  "author": "A. Gibson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ariangibson/understudy/issues"
  },
  "homepage": "https://github.com/ariangibson/understudy#readme",
  "bin": {
    "understudy": "bin/understudy.mjs"
  }
}
