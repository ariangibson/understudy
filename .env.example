# --- Gateway ---------------------------------------------------------------
PORT=3001

# Keys clients must present as `Authorization: Bearer <key>`.
# Comma-separated. Leave empty for open access (localhost only!).
GATEWAY_API_KEYS=

# Where per-request usage/cost records are appended (JSONL).
USAGE_LOG=data/usage.jsonl

# Default max_tokens when a client omits it (Anthropic requires one).
DEFAULT_MAX_TOKENS=4096

# Failover chain applied to EVERY request that doesn't bring its own
# `fallbacks` — this is what keeps unmodified agents running through rate
# limits and outages. Comma-separated, tried in order after the requested model.
# Example: FALLBACK_CHAIN=anthropic/claude-sonnet-4-6,openai/gpt-5-mini
FALLBACK_CHAIN=

# Circuit breaker: seconds a model stays benched after a rate limit or
# provider error (a Retry-After header from the provider takes precedence).
COOLDOWN_S=30

# Response cache: identical requests within the TTL are served from memory
# at zero cost (streaming included). Set CACHE_TTL_S=0 to disable.
CACHE_TTL_S=300
CACHE_MAX_ENTRIES=500

# --- Providers (set the ones you use; unset providers are simply inactive) --
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Local models via Ollama (keyless)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
